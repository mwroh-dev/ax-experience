# ── Slack ───────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_TEAM_ID=T0000000000
SLACK_VOC_INBOX_ID=C0000000000   # #voc-inbox Slack channel ID

# ── CDP (Playwright/Slack Electron) ──────────────────────────────────────────
CDP_URL=http://localhost:9222                     # Slack --remote-debugging-port

# ── Notion ───────────────────────────────────────────────────────────────────
NOTION_API_KEY=secret_your_notion_integration_key

# ── Gemini (optional) ────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Data / SQLite (optional) ─────────────────────────────────────────────────
# Both default to <repo-root>/.data/ regardless of which directory a process is
# launched from. Set these only to relocate the DBs (e.g. an absolute path on a
# server). Relative paths resolve against the current working directory.
# DB_PATH=.data/cs-ops.db              # operational DB (cases, automation_runs, RAG chunks)
# KNOWLEDGE_DB_PATH=.data/knowledge.db # routing knowledge base (auto_safe_patterns, judge_decisions)

