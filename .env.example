# ── Slack ───────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_TEAM_ID=T0000000000
SLACK_VOC_INBOX_ID=C0000000000   # #voc-inbox Slack channel ID

# ── OpenClaw Gateway ─────────────────────────────────────────────────────────
OPENCLAW_GATEWAY_TOKEN=your-gateway-auth-token   # must match gateway.auth.token in openclaw.json
OPENCLAW_GATEWAY_URL=http://localhost:18789
OPENCLAW_CONFIG_DIR=/absolute/path/to/config
OPENCLAW_WORKSPACE_DIR=/absolute/path/to/workspace
OPENCLAW_IMAGE=openclaw:local-ollama-mention      # Docker image tag; change if not using mention-strip patch

# ── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434            # used by logging-proxy.py on host

# ── CDP (Playwright/Slack Electron) ──────────────────────────────────────────
CDP_URL=http://localhost:9222                     # Slack --remote-debugging-port

# ── Notion ───────────────────────────────────────────────────────────────────
NOTION_API_KEY=secret_your_notion_integration_key

# ── Gemini (optional) ────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Runtime flags (Gate T3 / T4) ─────────────────────────────────────────────
OPENCLAW_SKIP_RUNTIME_CONTEXT=1        # strip gateway metadata from system prompt (T3)
OPENCLAW_STRIP_BOT_MENTION_FOR_MODEL=1 # strip @mention prefix from model input (T4)

# ── Dev flags ────────────────────────────────────────────────────────────────
OPENCLAW_CODEX_DISCOVERY_LIVE=0
