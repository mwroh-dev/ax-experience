# cs-ops-api environment variables
# Copy to .env and fill in actual values

PORT=3100

# cs-ops-api 전용 Slack App (권장 — OpenClaw와 앱 분리)
# api.slack.com에서 별도 앱 생성 후 발급
CS_OPS_SLACK_BOT_TOKEN=xoxb-your-csops-bot-token
CS_OPS_SLACK_APP_TOKEN=xapp-your-csops-app-token

# fallback: 단일 Slack App 임시 사용 시 (OpenClaw와 공유 — Socket Mode 이벤트 유실 위험)
# SLACK_BOT_TOKEN=xoxb-shared-bot-token
# SLACK_APP_TOKEN=xapp-shared-app-token

# Slack channel IDs (find in Slack URL or channel settings)
SLACK_VOC_REVIEW_CHANNEL=C0000000000
SLACK_VOC_LOG_CHANNEL=C0000000001

# SQLite DB path
DB_PATH=.data/cs-ops.db

# OpenClaw gateway URL
OPENCLAW_BASE_URL=http://localhost:18789

# Notion
NOTION_TOKEN=secret_your-notion-token-here
NOTION_CASES_DB_ID=your-notion-tickets-log-db-id
NOTION_IMPROVEMENT_BACKLOG_DB_ID=your-backlog-db-id
NOTION_AGENT_DECISIONS_DB_ID=your-agent-decisions-db-id
NOTION_FAQ_DB_ID=your-notion-faq-db-id
NOTION_POLICIES_DB_ID=your-notion-policies-db-id

# Slack VOC inbox channel ID
SLACK_VOC_INBOX_ID=C0000000002

# OpenClaw / Ollama auth (optional — 'ollama' used if unset)
OLLAMA_API_KEY=ollama

# Commerce API (Phase 1 — mock server)
COMMERCE_API_BASE_URL=http://localhost:3101

# Slack archive — allowlist (comma-separated channel IDs; empty = deny all)
ARCHIVE_ALLOWLIST=C0000000001,C0000000002

# Access control — reviewer allowlist (comma-separated Slack user IDs; empty = allow all)
ALLOWED_REVIEWER_IDS=U0000000001,U0000000002

# Test endpoints — /api/test/* (run-draft, admin-lookup, action)
# Set to true only in dev/staging. Automatically blocked when NODE_ENV=production and this is unset.
ENABLE_TEST_ENDPOINTS=true
