# cs-ops-api — CS Ops Automation Harness
# Copy to .env and fill in actual values

# Slack (Bolt app)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_CS_REVIEW_CHANNEL_ID=C_your_review_channel
SLACK_VOC_LOG_CHANNEL_ID=C_your_voc_log_channel
SLACK_CS_MANAGER_CHANNEL_ID=C_your_manager_channel

# Notion integration
NOTION_TOKEN=secret_your-notion-integration-token
NOTION_FAQ_DB_ID=your-faq-db-id
NOTION_POLICIES_DB_ID=your-policies-db-id
NOTION_AUTOMATION_RUNS_DB_ID=your-automation-runs-db-id

# LLM backend (Ollama by default)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
# OLLAMA_API_KEY=ollama  # set only if your Ollama instance requires auth

# Auto-send control (set to 'true' to allow the bot to auto-post draft replies)
# CS_OPS_ALLOW_AUTO_SEND=false

# Commerce mock server (used in tests)
# MOCK_ADMIN_API_URL=http://localhost:3101
# MOCK_ADMIN_PORT=3101
